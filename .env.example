# Copy to .env and fill in. Never commit .env.
#
# Which optional services docker compose starts, comma-separated:
#   (empty)          SQLite + local media
#   mysql            MySQL + local media
#   postgresql       PostgreSQL + local media
#   mysql,rustfs     MySQL + RustFS object storage
# Set the matching application backends with the variables below (or in
# config.toml). Non-empty environment values win.
COMPOSE_PROFILES=

# Optional architecture overrides. With these, .env alone decides which
# backends the application uses; empty values fall back to config.toml.
# FORESIGHT_DATABASE_BACKEND: sqlite | postgresql | mysql
FORESIGHT_DATABASE_BACKEND=
FORESIGHT_DATABASE_HOST=
FORESIGHT_DATABASE_PORT=
FORESIGHT_DATABASE_NAME=
FORESIGHT_DATABASE_USER=
FORESIGHT_DATABASE_PATH=
# FORESIGHT_MEDIA_BACKEND: local | s3
FORESIGHT_MEDIA_BACKEND=
FORESIGHT_MEDIA_LOCAL_ROOT=
FORESIGHT_S3_BUCKET=
FORESIGHT_S3_ENDPOINT_URL=
FORESIGHT_S3_REGION=
FORESIGHT_S3_PREFIX=
# FORESIGHT_S3_USE_PATH_STYLE: true | false
FORESIGHT_S3_USE_PATH_STYLE=

DISCORD_TOKEN=
# Comma-separated channel IDs to capture; overrides config.toml when set.
DISCORD_CHANNEL_IDS=
# Required because compose binds the API to 0.0.0.0.
FORESIGHT_API_TOKEN=
# OpenAI-compatible key (MiniMax, OpenAI, ...); set ai.base_url and ai.model
# in config.toml to match.
FORESIGHT_LLM_API_KEY=
# Required when COMPOSE_PROFILES includes mysql or postgresql.
FORESIGHT_DB_PASSWORD=
# Required when COMPOSE_PROFILES includes rustfs. This one pair is both the
# RustFS root credentials and the keys ForeSight signs S3 requests with.
# Use only uppercase letters and digits for the access key; generate the
# secret with `openssl rand -base64 24`. Never use the default rustfsadmin pair.
FORESIGHT_S3_ACCESS_KEY_ID=
FORESIGHT_S3_SECRET_ACCESS_KEY=

# The port the API is published on by docker compose. It moves the host
# side of the mapping and nothing else.
FORESIGHT_PORT=8000

# Host ports for the RustFS S3 API and web console when rustfs is enabled.
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# The configuration file and the address of the API. They override the
# values of config.toml. docker compose sets them for the container, so
# they only matter for a run outside of compose — uncomment them only if
# you mean it.
# FORESIGHT_CONFIG=config.toml
# FORESIGHT_API_HOST=127.0.0.1
# FORESIGHT_API_PORT=8000
