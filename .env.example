# Copy to .env and fill in. Never commit .env.
DISCORD_TOKEN=
FORESIGHT_API_TOKEN=
FORESIGHT_LLM_API_KEY=
FORESIGHT_DB_PASSWORD=

# For the mysql+rustfs compose these two keys are both the RustFS root
# credentials and the keys ForeSight signs S3 requests with. Use only
# uppercase letters and digits for the access key; generate the secret with
# `openssl rand -base64 24`. Never use the default rustfsadmin pair.
FORESIGHT_S3_ACCESS_KEY_ID=
FORESIGHT_S3_SECRET_ACCESS_KEY=

# The port the API is published on by docker compose. It moves the host
# side of the mapping and nothing else.
FORESIGHT_PORT=8000

# Host ports for the RustFS S3 API and web console in the mysql+rustfs stack.
# Change these if 9000/9001 are already taken on the host.
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# The configuration of the service and the address of the API. They
# override the values of config.toml. docker compose sets them for the
# container, so they only matter for a run outside of compose — uncomment
# them only if you mean it.
# FORESIGHT_CONFIG=config.toml
# FORESIGHT_API_HOST=127.0.0.1
# FORESIGHT_API_PORT=8000
